# Environment variables and secrets
# Copy to .env and fill in real values. Never commit .env.
#
# Supabase connection string (Project Settings -> Database -> Connection string -> URI).
# Use the pooler host for IPv4 compatibility. SSL is negotiated automatically.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Signing key for JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
